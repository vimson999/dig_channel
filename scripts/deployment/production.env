# 生产环境配置
FLASK_ENV=production
FLASK_DEBUG=False

# 数据库配置
# 生产必须使用 PostgreSQL，并建议应用连接 PgBouncer 的 transaction pool。
# 例：postgresql+psycopg2://cappa_rw:password@127.0.0.1:6432/cappa
DATABASE_URL=postgresql+psycopg2://app_user:change_me@127.0.0.1:6432/app_db
DATABASE_TYPE=postgresql

# SQLAlchemy 连接策略：应用侧少持有连接，PgBouncer 负责复用。
WEB_DB_POOL_MODE=queue
WEB_DB_POOL_SIZE=4
WEB_DB_MAX_OVERFLOW=0
WORKER_DB_POOL_MODE=null
WORKER_DB_POOL_SIZE=1
WORKER_DB_MAX_OVERFLOW=0
SCHEDULER_DB_POOL_MODE=null
SCHEDULER_DB_POOL_SIZE=1
SCHEDULER_DB_MAX_OVERFLOW=0
DB_CONNECT_TIMEOUT=5
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=60000

# 任务准入保护：DB 压力大或同类任务超预算时自动延迟，不把数据库打挂。
TASK_ADMISSION_GUARD_ENABLED=1
TASK_ADMISSION_DB_MIN_FREE_CONNECTIONS=12
TASK_ADMISSION_DB_MAX_USED_RATIO=0.85
TASK_ADMISSION_DB_MAX_IDLE_IN_TX=5
TASK_ADMISSION_DB_FAIL_CLOSED=1
TASK_ADMISSION_RETRY_DELAY_SECONDS=180
TASK_ADMISSION_FEATURE_LIMITS=publisher=4,report_audio_workflow=2,report_pdf_audio_workflow=2,mp3_video_workflow=1,content_pdf_clean=2,content_audio_clean=1,zsxq_clean_output_publish=1
TASK_ADMISSION_FEATURE_BACKLOG_LIMITS=publisher=12,report_audio_workflow=10,report_pdf_audio_workflow=10,mp3_video_workflow=5,content_pdf_clean=10,content_audio_clean=5,zsxq_clean_output_publish=5

# 人为暂停的 worker 不会被看门狗或后端自举自动拉起。
CELERY_PAUSED_SERVICES=

# YouTube API配置
YOUTUBE_API_KEY=your_youtube_api_key_here

# 安全配置
SECRET_KEY=your_production_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# 服务器配置
HOST=0.0.0.0
PORT=5000

# 日志配置
LOG_LEVEL=INFO

# CORS配置
CORS_ORIGINS=https://youtube-analytics.example.com

# 限流配置
RATELIMIT_STORAGE_URL=redis://localhost:6379/0

# SSL配置
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

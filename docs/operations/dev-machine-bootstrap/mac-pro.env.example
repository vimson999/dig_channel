# Mac Pro development environment template.
# Copy this file to the repository root as .env, chmod 600, then replace every
# REQUIRED_* placeholder through a secure channel. Never commit the resulting .env.

# Core application
DATABASE_TYPE=postgresql
SQLITE_DATABASE_PATH=
FLASK_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=5001
SECRET_KEY=REQUIRED_GENERATE_A_UNIQUE_SECRET_ON_MAC_PRO
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_TO_CONSOLE=true
CORS_ORIGINS=http://127.0.0.1:5001,http://localhost:5001

# PostgreSQL. URL-encode username/password before inserting them into URLs.
# The application uses local PgBouncer; DIRECT_DATABASE_URL remains the real server.
DIRECT_DATABASE_URL=postgresql://REQUIRED_DB_USER:REQUIRED_URL_ENCODED_DB_PASSWORD@100.92.99.39:5432/show_ytb_data
DATABASE_URL=postgresql://REQUIRED_DB_USER:REQUIRED_URL_ENCODED_DB_PASSWORD@127.0.0.1:6432/show_ytb_data
LOCAL_PGBOUNCER_ENABLED=1
LOCAL_PGBOUNCER_HOST=127.0.0.1
LOCAL_PGBOUNCER_PORT=6432
LOCAL_PGBOUNCER_MIN_POOL_SIZE=6
LOCAL_PGBOUNCER_SERVER_IDLE_TIMEOUT=600
LOCAL_PGBOUNCER_SERVER_LIFETIME=1800
LOCAL_PGBOUNCER_QUERY_TIMEOUT=20

# Role-specific database pools
WEB_DB_POOL_SIZE=4
WEB_DB_MAX_OVERFLOW=0
WORKER_DB_POOL_MODE=null
WORKER_DB_POOL_SIZE=1
WORKER_DB_MAX_OVERFLOW=0
SCHEDULER_DB_POOL_MODE=null
SCHEDULER_DB_POOL_SIZE=1
SCHEDULER_DB_MAX_OVERFLOW=0
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_CONNECT_TIMEOUT=5
SQL_ECHO=False

# Redis allocation for DIG development on Mac Pro: DB7 cache, DB8 broker, DB9 result.
# Keep the same Redis credential across these URLs but never reuse Mac mini DB4-6.
REDIS_URL=redis://:REQUIRED_REDIS_PASSWORD@100.92.99.39:6379/7
CACHE_REDIS_URL=redis://:REQUIRED_REDIS_PASSWORD@100.92.99.39:6379/7
CELERY_BROKER_URL=redis://:REQUIRED_REDIS_PASSWORD@100.92.99.39:6379/8
CELERY_RESULT_BACKEND=redis://:REQUIRED_REDIS_PASSWORD@100.92.99.39:6379/9
CACHE_TIMEOUT=300

# Celery defaults
CELERY_TASK_TIME_LIMIT=7200
CELERY_TASK_SOFT_TIME_LIMIT=6900
CELERY_RESULT_EXPIRES=3600
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=10

# Safe first boot: enable workers/watchdog only after Redis DB7-9 and API checks pass.
BACKEND_PROCESS_BOOTSTRAP_ENABLED=1
BACKEND_PROCESS_BOOTSTRAP_MODE=ensure
BACKEND_PROCESS_BOOTSTRAP_CELERY_SERVICES=none
BACKEND_PROCESS_BOOTSTRAP_SCHEDULERS=none
BACKEND_PROCESS_BOOTSTRAP_WATCHDOG=0
CELERY_AUTO_HEAL_ENABLED=1
CELERY_AUTO_HEAL_NOTIFY_ENABLED=1
CELERY_AUTO_HEAL_SERVICES=none
CELERY_AUTO_HEAL_CONFIRMATIONS=3
CELERY_AUTO_HEAL_COOLDOWN_SECONDS=600
CELERY_AUTO_HEAL_POLL_SECONDS=60

# General runtime
DEFAULT_CPM=10
CRAWL_INTERVAL_HOURS=24
MAX_RETRY_ATTEMPTS=3
REQUEST_TIMEOUT=30
API_RATE_LIMIT=1000 per hour
JWT_EXPIRATION_HOURS=24
WORKER_PROCESSES=1
WORKER_THREADS=4
ZSXQ_SYNC_TEST_INTERVAL_MINUTES=30

# YouTube / Google
YOUTUBE_API_KEY=REQUIRED_YOUTUBE_API_KEY
GOOGLE_API_KEYS=REQUIRED_COMMA_SEPARATED_GOOGLE_API_KEYS

# Reddit (leave disabled until credentials are supplied)
REDDIT_ENABLED=false
REDDIT_CLIENT_ID=REQUIRED_IF_ENABLED
REDDIT_CLIENT_SECRET=REQUIRED_IF_ENABLED
REDDIT_USER_AGENT=dig-ytb-mac-pro-development

# Bilibili authentication
BILI_SESSDATA=REQUIRED_BILIBILI_SESSDATA
BILI_BILI_JCT=REQUIRED_BILIBILI_JCT
BILI_BUVID3=REQUIRED_BILIBILI_BUVID3
BILI_DEDEUSERID=REQUIRED_BILIBILI_DEDEUSERID
BILIBILI_UPLOAD_TIMEOUT_SECONDS=7200

# LLM / TTS
DOUBAO_TTS_API_KEY_NAME=REQUIRED_DOUBAO_KEY_NAME
DOUBAO_TTS_API_KEY=REQUIRED_DOUBAO_API_KEY
DOUBAO_TTS_RESOURCE_ID=REQUIRED_DOUBAO_RESOURCE_ID
DEEPSEEK_API_KEY=REQUIRED_DEEPSEEK_API_KEY

# ZSXQ
ZSXQ_SYNC_TEST_COOKIE=REQUIRED_ZSXQ_COOKIE

# Workflow notifications
WORKFLOW_NOTIFY_PROVIDER=email
WORKFLOW_NOTIFY_LEVEL=terminal
WORKFLOW_NOTIFY_TO=REQUIRED_NOTIFICATION_RECIPIENT
WORKFLOW_EMAIL_SMTP_HOST=REQUIRED_SMTP_HOST
WORKFLOW_EMAIL_SMTP_PORT=465
WORKFLOW_EMAIL_USER=REQUIRED_SMTP_USER
WORKFLOW_EMAIL_PASSWORD=REQUIRED_SMTP_PASSWORD
WORKFLOW_EMAIL_FROM=REQUIRED_SMTP_FROM_ADDRESS
WORKFLOW_EMAIL_FROM_NAME=DIG Mac Pro Dev

# Server-local website contact message API
CONTACT_API_KEY=REQUIRED_RANDOM_CONTACT_API_KEY_AT_LEAST_32_CHARS
CONTACT_API_ALLOWED_IPS=127.0.0.1,::1
CONTACT_TO_EMAIL=REQUIRED_CONTACT_RECIPIENT

# Browser automation. Replace REQUIRED_MAC_USER and create independent profiles.
DOUBAO_BROWSER_TTS_USER_DATA_DIR=/Users/REQUIRED_MAC_USER/dig-browser-profiles/doubao
DOUBAO_BROWSER_TTS_PROFILE_DIRECTORY=Default
DOUBAO_BROWSER_TTS_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
GEMINI_BROWSER_URL=https://gemini.google.com/app
GEMINI_BROWSER_USER_DATA_DIR=/Users/REQUIRED_MAC_USER/dig-browser-profiles/gemini
GEMINI_BROWSER_PROFILE_DIRECTORY=Default
GEMINI_BROWSER_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
REPORT_DORAEMON_STORYBOARD_GEMINI_URL=https://gemini.google.com/app
REPORT_DORAEMON_IMAGE_GEMINI_URL=https://gemini.google.com/app

# Machine-local proxy. Keep empty unless the Mac Pro proxy endpoint is known.
HTTP_PROXY=
HTTPS_PROXY=
# Example: HTTP_PROXY=http://127.0.0.1:REQUIRED_PROXY_PORT
# Example: HTTPS_PROXY=http://127.0.0.1:REQUIRED_PROXY_PORT

# Development behavior
FLASK_TOOLBAR_ENABLED=False
FLASK_RELOAD=False

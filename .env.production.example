# Copy to .env.production on the server only. Never commit the real file.
FLASK_ENV=production
FLASK_DEBUG=0
AUTH_MODE=production
LOCAL_AUTH_BYPASS=0
AUTH_REQUIRE_ADMIN=1
AUTH_VERSION_ENABLED=1
PUBLIC_REGISTRATION_ENABLED=0

# Generate each value independently with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET_KEY=replace-with-a-different-random-value
LOGIN_PORTAL_TOKEN=replace-with-at-least-32-random-characters

DATABASE_URL=postgresql+psycopg2://app_user:replace-me@db:5432/app_db
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URL=redis://redis:6379/0
CORS_ORIGINS=https://youtube-analytics.example.com
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Strict
PASSWORD_MIN_LENGTH=14
JWT_ACCESS_TOKEN_EXPIRES=900
LOGIN_PORTAL_TTL_SECONDS=600
LOGIN_IP_RATE_LIMIT=30 per minute;300 per day
LOGIN_ACCOUNT_RATE_LIMIT=5 per 15 minutes
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
MAX_LOG_SIZE_MB=100
MAX_BACKUP_COUNT=10

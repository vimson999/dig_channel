# YouTube频道数据追踪工具 - 环境变量配置示例
# 复制此文件为 .env 并填入实际的配置值

# ===========================================
# YouTube API配置 (必填)
# ===========================================
# YouTube Data API v3 密钥
# 获取方式: https://console.developers.google.com/
# 1. 创建项目或选择现有项目
# 2. 启用 YouTube Data API v3
# 3. 创建凭据 > API密钥
# 4. 复制API密钥到下方
YOUTUBE_API_KEY=AIzaSyCz1pMP7uzrNse6eim6JgFafIGYOmzyBA0

# ===========================================
# 数据库配置 (可选，默认使用SQLite)
# ===========================================
# 数据库类型 (sqlite/mysql/postgresql)
DATABASE_TYPE=postgresql

# SQLite数据库文件路径 (相对于项目根目录)
SQLITE_DATABASE_PATH=instance/youtube_tracker.db

# MySQL/PostgreSQL数据库连接配置 (如果使用)
# DATABASE_URL=mysql://username:password@localhost:3306/youtube_tracker
DATABASE_URL=postgresql://cappa_rw:RWcappaDb!!!2025@101.35.56.140:5432/show_ytb_data

# ===========================================
# Flask应用配置 (可选)
# ===========================================
# Flask应用密钥 (用于会话加密等)
SECRET_KEY=dev_secret_key_for_testing

# 运行环境 (development/production)
FLASK_ENV=development

# 调试模式 (True/False)
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=5001

# ===========================================
# 数据抓取配置 (可选)
# ===========================================
# 默认CPM值 (每千次展示成本)
DEFAULT_CPM=1.00

# 数据抓取间隔 (小时)
CRAWL_INTERVAL_HOURS=8

# 最大重试次数
MAX_RETRY_ATTEMPTS=3

# 请求超时时间 (秒)
REQUEST_TIMEOUT=30

# ===========================================
# 日志配置 (可选)
# ===========================================
# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/app.log

# 是否输出到控制台
LOG_TO_CONSOLE=True

# ===========================================
# 缓存配置 (可选)
# ===========================================
# Redis连接URL (如果使用Redis缓存)
REDIS_URL=redis://localhost:6379/0

# 缓存过期时间 (秒)
CACHE_TIMEOUT=3600

# ===========================================
# Celery异步任务配置 (可选)
# ===========================================
# Celery消息队列配置 (使用Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 任务超时配置 (秒)
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# 结果过期时间 (秒)
CELERY_RESULT_EXPIRES=3600

# 工作进程配置
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# ===========================================
# 安全配置 (生产环境必填)
# ===========================================
# CORS允许的域名 (逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://localhost:5001

# API速率限制 (每分钟请求数)
API_RATE_LIMIT=100

# JWT令牌过期时间 (小时)
JWT_EXPIRATION_HOURS=24

# ===========================================
# 监控和报警配置 (可选)
# ===========================================
# 邮件通知配置
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USERNAME=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password
# EMAIL_FROM=your_email@gmail.com
# EMAIL_TO=admin@example.com

# Webhook通知URL
# WEBHOOK_URL=https://hooks.slack.com/services/...

# ===========================================
# 性能配置 (可选)
# ===========================================
# 数据库连接池大小
DB_POOL_SIZE=10

# 并发工作进程数
WORKER_PROCESSES=2

# 每个进程的线程数
WORKER_THREADS=2

# ===========================================
# Reddit API 配置 (商机发现)
# ===========================================
REDDIT_ENABLED=True
REDDIT_CLIENT_ID=xS0V2XU1_Of1GmcfFVWA-g
REDDIT_CLIENT_SECRET=axBpAYLqfz5TOl6M1QQZvbv5VzAdIg
REDDIT_USER_AGENT=OpportunityBot/1.0 (by /u/shioatech)

# ===========================================
# 开发配置 (仅开发环境)
# ===========================================
# 是否启用SQL查询日志
SQL_ECHO=False

# 是否启用Flask工具栏
FLASK_TOOLBAR_ENABLED=False

# 是否启用热重载
FLASK_RELOAD=True

# ===========================================
# 配置说明
# ===========================================
# 1. 必填项目: YOUTUBE_API_KEY
# 2. 建议修改: SECRET_KEY (生产环境)
# 3. 可选配置: 其他所有配置都有默认值
# 4. 配置文件位置: 项目根目录/.env
# 5. 重启应用: 修改配置后需要重启Flask应用

# ===========================================
# 常见问题
# ===========================================
# Q: YouTube API密钥在哪里获取?
# A: https://console.developers.google.com/ -> 创建项目 -> 启用YouTube Data API v3 -> 创建API密钥

# Q: 如何知道配置是否正确?
# A: 启动应用后访问 http://localhost:5001/health 检查健康状态

# Q: 数据库文件在哪里?
# A: SQLite数据库文件默认在 instance/youtube_tracker.db

# Q: 如何查看日志?
# A: 日志默认输出到控制台，也可以配置LOG_FILE输出到文件

# Q: 如何修改端口?
# A: 修改PORT配置，同时需要修改前端js/config.js中的API_BASE_URL



